<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_OrderFulfillment"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="camunda8-lab" exporterVersion="1.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">

  <bpmn:process id="order-fulfillment-process" name="Order Fulfillment" isExecutable="true">

    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_InStock" name="In Stock?">
      <bpmn:incoming>Flow_Validate_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Charge</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Backorder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ChargePayment" name="Charge Payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_Charge</bpmn:incoming>
      <bpmn:outgoing>Flow_Charge_Ship</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ShipOrder" name="Ship Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ship-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Charge_Ship</bpmn:incoming>
      <bpmn:outgoing>Flow_Ship_Confirm</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ConfirmDelivery" name="Confirm Delivery">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ship_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>Flow_Confirm_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_NotifyBackorder" name="Notify Backorder">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-backorder" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_Backorder</bpmn:incoming>
      <bpmn:outgoing>Flow_Backorder_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Backordered" name="Order Backordered">
      <bpmn:incoming>Flow_Backorder_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="StartEvent_OrderReceived" targetRef="Task_ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_Validate_Gateway" sourceRef="Task_ValidateOrder" targetRef="Gateway_InStock" />
    <bpmn:sequenceFlow id="Flow_Gateway_Charge" name="Yes" sourceRef="Gateway_InStock" targetRef="Task_ChargePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=inStock = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Backorder" name="No" sourceRef="Gateway_InStock" targetRef="Task_NotifyBackorder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=inStock = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Charge_Ship" sourceRef="Task_ChargePayment" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_Ship_Confirm" sourceRef="Task_ShipOrder" targetRef="Task_ConfirmDelivery" />
    <bpmn:sequenceFlow id="Flow_Confirm_End" sourceRef="Task_ConfirmDelivery" targetRef="EndEvent_OrderCompleted" />
    <bpmn:sequenceFlow id="Flow_Backorder_End" sourceRef="Task_NotifyBackorder" targetRef="EndEvent_Backordered" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order-fulfillment-process">

      <bpmndi:BPMNShape id="StartEvent_OrderReceived_di" bpmnElement="StartEvent_OrderReceived">
        <dc:Bounds x="152" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="132" y="165" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ValidateOrder_di" bpmnElement="Task_ValidateOrder">
        <dc:Bounds x="240" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_InStock_di" bpmnElement="Gateway_InStock" isMarkerVisible="true">
        <dc:Bounds x="400" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="393" y="85" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ChargePayment_di" bpmnElement="Task_ChargePayment">
        <dc:Bounds x="500" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder">
        <dc:Bounds x="650" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConfirmDelivery_di" bpmnElement="Task_ConfirmDelivery">
        <dc:Bounds x="800" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_OrderCompleted_di" bpmnElement="EndEvent_OrderCompleted">
        <dc:Bounds x="960" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="937" y="165" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyBackorder_di" bpmnElement="Task_NotifyBackorder">
        <dc:Bounds x="500" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Backordered_di" bpmnElement="EndEvent_Backordered">
        <dc:Bounds x="650" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="628" y="345" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Validate_di" bpmnElement="Flow_Start_Validate">
        <di:waypoint x="188" y="140" />
        <di:waypoint x="240" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Validate_Gateway_di" bpmnElement="Flow_Validate_Gateway">
        <di:waypoint x="340" y="140" />
        <di:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Gateway_Charge_di" bpmnElement="Flow_Gateway_Charge">
        <di:waypoint x="450" y="140" />
        <di:waypoint x="500" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="467" y="122" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Charge_Ship_di" bpmnElement="Flow_Charge_Ship">
        <di:waypoint x="600" y="140" />
        <di:waypoint x="650" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Ship_Confirm_di" bpmnElement="Flow_Ship_Confirm">
        <di:waypoint x="750" y="140" />
        <di:waypoint x="800" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Confirm_End_di" bpmnElement="Flow_Confirm_End">
        <di:waypoint x="900" y="140" />
        <di:waypoint x="960" y="140" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Gateway_Backorder_di" bpmnElement="Flow_Gateway_Backorder">
        <di:waypoint x="425" y="165" />
        <di:waypoint x="425" y="320" />
        <di:waypoint x="500" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="433" y="240" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Backorder_End_di" bpmnElement="Flow_Backorder_End">
        <di:waypoint x="600" y="320" />
        <di:waypoint x="650" y="320" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
